{
  "name": "express-store",
  "version": "1.0.0",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "DATABASE_URL=file:./test.db JWT_SECRET=test-jwt-secret prisma db push && DATABASE_URL=file:./test.db JWT_SECRET=test-jwt-secret node --experimental-vm-modules ./node_modules/.bin/jest --runInBand",
    "test:coverage": "npm test -- --coverage",
    "migrate": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} prisma migrate deploy",
    "seed": "node prisma/seed.js"
  },
